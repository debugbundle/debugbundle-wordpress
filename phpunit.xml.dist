<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true">
  <source>
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>
  <testsuites>
    <testsuite name="DebugBundle WordPress Plugin">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
</phpunit>
